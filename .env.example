# Medical Companion PWA - Frontend Environment Variables
# Copy this file to .env and configure with your values

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# API Base URL - Backend server endpoint
VITE_API_BASE_URL=http://localhost:3001

# Storage Configuration
# true: Use PostgreSQL backend storage (recommended)
# false: Use IndexedDB only (offline-only mode)
VITE_USE_SERVER_STORAGE=true

# ============================================
# CORS CONFIGURATION
# ============================================

# Allowed origins for CORS (comma-separated)
# Add your production domain here
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ============================================
# DATABASE CONFIGURATION (Backend will use)
# ============================================

# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://meduser:your_password_here@localhost:5432/medcompanion

# Database feature flag
USE_POSTGRESQL=true

# Connection pool settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ============================================
# AUTHENTICATION
# ============================================

# JWT secret for token signing
# IMPORTANT: Generate a secure random string (minimum 32 characters)
# Use: openssl rand -base64 64
JWT_SECRET=change-this-to-a-very-secure-secret-key-minimum-32-characters

# Session configuration
SESSION_EXPIRY_DAYS=30
REFRESH_TOKEN_EXPIRY_DAYS=90

# ============================================
# AI SERVICES API KEYS
# ============================================

# Anthropic API Key (for Claude AI)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API Key (for Whisper transcription)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Brave Search API Key (for web research)
# Get from: https://brave.com/search/api/
BRAVE_API_KEY=BSA-your-brave-key-here

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3001

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# COST MANAGEMENT
# ============================================

# Monthly budget limit in USD
MONTHLY_BUDGET_USD=20

# Enable cost tracking
TRACK_API_COSTS=true

# Alert when budget reaches this percentage
BUDGET_ALERT_THRESHOLD=80

# ============================================
# LOGGING
# ============================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable SQL query logging (debug only)
LOG_SQL=false

# ============================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ============================================

# SMTP configuration (for production alerts)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-key
# ALERT_EMAIL=admin@yourdomain.com

# ============================================
# OPTIONAL: MONITORING (Production)
# ============================================

# Sentry error tracking
# SENTRY_DSN=https://your-key@sentry.io/your-project

# ============================================
# NOTES
# ============================================
#
# 1. Never commit this file with real values
# 2. Keep sensitive data in .env (which is gitignored)
# 3. For production, use environment variables or secret management
# 4. Rotate secrets regularly (every 90-180 days)
# 5. Use strong, unique passwords for database
#
# For detailed documentation, see ENVIRONMENT_VARIABLES.md
# Docker Environment Configuration
# Copy this to .env and fill in your actual API keys before building

# API Keys (these will be baked into the Docker image)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# JWT Secret for authentication (MUST CHANGE THIS!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random

# Application Settings
NODE_ENV=production
PORT=3001

# Medical Search Configuration
ENABLE_REAL_MEDICAL_SEARCH=true
ENABLE_WEB_SEARCH=true
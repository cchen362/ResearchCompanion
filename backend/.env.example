# Backend Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
USE_POSTGRESQL=true # Set to true to use PostgreSQL, false for SQLite
DATABASE_URL=postgresql://meduser:medpass123@postgres:5432/medcompanion
DB_PASSWORD=medpass123 # Change in production!

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Keys (Required for AI features)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
BRAVE_API_KEY=your-brave-api-key
PUBMED_API_KEY=your-pubmed-api-key # Optional

# Medical Search Configuration
ENABLE_REAL_MEDICAL_SEARCH=true
ENABLE_WEB_SEARCH=true

# Search Result Limits (configurable for cost/performance tuning)
# Increasing these will provide more comprehensive research but increase AI costs
PUBMED_RESULT_LIMIT=20        # Default was 10, can go up to 50
CLINICAL_TRIALS_LIMIT=20      # Default was 10, can go up to 50
FDA_RESULT_LIMIT=15           # Default was 10
WEB_SEARCH_LIMIT=10           # Default was 5

# CORS Configuration (Frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Database Connection Pool Settings (Optional)
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Legacy SQLite Path (if not using PostgreSQL)
SQLITE_DB_PATH=./data/users.db